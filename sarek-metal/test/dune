; Device-only vectors, ranged copies, pinned memory, streams/events on a Metal
; device (specs/metal-ranged-copies.md). Needs an Apple GPU, which no CI
; runner has: alias e2e-metal is declared in scripts/unwired-targets.tsv and
; run by hand on a Mac. Self-skips without a Metal device.

(executable
 (name test_metal_device_buffers)
 (modules test_metal_device_buffers)
 (libraries
  device_buffers_suite
  spoc_core
  sarek_metal
  sarek_backend_error
  ctypes
  unix))

(rule
 (alias e2e-metal)
 (action
  (run %{dep:test_metal_device_buffers.exe})))

; 256 MiB ranged-copy bandwidth on Metal. Information only, never a gate.

(executable
