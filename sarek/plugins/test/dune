; An out-of-tree consumer must be able to link the CPU backends from the
; install tree: install_consumer.t builds a fresh dune project whose OCAMLPATH
; is _build/install/default/lib (set by dune for cram tests; third-party deps
; still come from the switch, where sarek is not installed), so a library that
; is not installed -- no public_name -- cannot resolve.
;
; The dependency is the root @install alias, not (package sarek): the latter
; trips a sarek <-> sarek-cuda package-files dependency cycle.

(cram
 (applies_to install_consumer)
 (deps
  (alias_rec %{workspace_root}/install)))
