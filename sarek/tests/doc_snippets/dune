; Every page that has an ocaml block must have a rule above: this check fails
; on a page of the two site folders (or on a listed library README) that the
; rules do not mention.

(rule
 (alias snippets)
 (deps
  dune
  ../../../README.md
  ../../../gh-pages/index.md
  ../../../sarek/core/README.md
  ../../../sarek/sarek/README.md
  ../../../sarek/ppx/README.md
  (glob_files ../../../gh-pages/docs/*.md)
  (glob_files ../../../gh-pages/examples/*.md))
 (action
  (run %{exe:extract.exe} --check-listed %{deps})))

(alias
 (name snippets)
 (deps doc_snippets.cma))

(alias
 (name runtest)
 (deps
  (alias snippets)))
