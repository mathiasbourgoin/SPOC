; Documentation snippets: every ```ocaml block of the Markdown pages listed
; below is extracted (extract.exe) into one module per page and compiled with
; the library names a downstream project uses. Nothing is linked or run.
; `dune build @snippets` is part of `dune runtest`; see CONTRIBUTING.md,
; "Documentation snippets".

(executable
 (name extract)
 (modules extract))

(library
 (name doc_snippets)
 (modules :standard \ extract)
 (libraries
  sarek
  sarek.core
  sarek.stdlib
  sarek.native
  sarek.interpreter
  sarek-cuda.plugin
  sarek-hip.plugin
  sarek-opencl.plugin
  sarek-vulkan.plugin
  sarek-metal.plugin)
 (preprocess
  (pps sarek.ppx))
 (flags
  (:standard -w -a -alert -sarek_matrix)))

(rule
 (targets snip_readme.ml)
 (action
  (with-stdout-to
   snip_readme.ml
   (run %{exe:extract.exe} %{dep:../../../README.md}))))

(rule
 (targets snip_site_index.ml)
 (action
  (with-stdout-to
   snip_site_index.ml
   (run %{exe:extract.exe} %{dep:../../../gh-pages/index.md}))))

(rule
 (targets snip_docs_concepts.ml)
 (action
  (with-stdout-to
   snip_docs_concepts.ml
   (run %{exe:extract.exe} %{dep:../../../gh-pages/docs/concepts.md}))))

(rule
