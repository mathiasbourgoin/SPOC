; An unknown item warns on stderr, the rest applies.

(rule
 (targets unknown.out unknown.raw)
 (action
  (setenv
   SAREK_OPT_DISABLE
   "window,bogus,UNROLL, ,"
   (setenv
    SAREK_EXPLAIN
    ""
    (with-stdout-to
     unknown.out
     (with-stderr-to
      unknown.raw
      (run %{exe:test_policy_env.exe} unknown)))))))

(rule
 (targets unknown.err)
 (deps unknown.raw)
 (action
  (with-stdout-to
   unknown.err
   (system "grep -v ASSERT unknown.raw || true"))))

(rule
 (alias runtest)
 (action
  (diff unknown.expected unknown.err)))

; The five replaced variables are set: they change nothing and say nothing.

(rule
 (targets removed.out removed.raw)
 (action
  (setenv
   SAREK_OPT_DISABLE
   ""
   (setenv
    SAREK_EXPLAIN
    ""
    (setenv
     SAREK_LAUNCH_WINDOW
     "0"
     (setenv
      SAREK_LAUNCH_EPILOGUE
      "0"
      (setenv
       SAREK_MATRIX_REWRITE
       "off"
       (setenv
        SAREK_AUTO_UNROLL
        "0"
        (setenv
         SAREK_MATRIX_REPORT
         "1"
         (with-stdout-to
          removed.out
          (with-stderr-to
           removed.raw
           (run %{exe:test_policy_env.exe} removed))))))))))))

(rule
 (targets removed.err)
 (deps removed.raw)
 (action
  (with-stdout-to
   removed.err
   (system "grep -v ASSERT removed.raw || true"))))

(rule
 (alias runtest)
 (action
  (diff empty.expected removed.err)))

; SAREK_EXPLAIN: the default reporter writes the golden lines to stderr.

(rule
 (targets explain.out explain.raw)
 (action
  (setenv
   SAREK_OPT_DISABLE
   ""
   (setenv
    SAREK_EXPLAIN
    "1"
    (with-stdout-to
     explain.out
     (with-stderr-to
      explain.raw
      (run %{exe:test_policy_env.exe} explain)))))))

(rule
 (targets explain.err)
 (deps explain.raw)
 (action
  (with-stdout-to
   explain.err
   (system "grep -v ASSERT explain.raw || true"))))

(rule
 (alias runtest)
 (action
  (diff explain.expected explain.err)))

(rule
 (targets explain-off.out explain-off.raw)
 (action
  (setenv
   SAREK_OPT_DISABLE
   ""
   (setenv
    SAREK_EXPLAIN
    "0"
