; SAREK_OPT_DISABLE and SAREK_EXPLAIN (specs/optimisation-policy.md, M3).
; The variables are read when the process starts and every restriction is
; one-way, so each scenario is the same executable run once with its own
; environment (test_policy_env.ml lists what each one checks). No device.
; Scenarios whose stderr matters write it to a file that is compared with a
; golden. Every rule sets both variables, to "" where the scenario does not
; use one, so that the caller's environment cannot change the result.

(executable
 (name test_policy_env)
 (modules test_policy_env policy_env_fixtures)
 (libraries
  sarek
  sarek_stdlib
  sarek_execute
  sarek_codegen
  sarek_ir
  spoc_core
  alcotest)
 (preprocess
  (pps sarek_ppx)))

; The exit status is the verdict.

(rule
 (alias runtest)
 (action
  (setenv
   SAREK_OPT_DISABLE
   ""
   (setenv
    SAREK_EXPLAIN
    ""
    (run %{exe:test_policy_env.exe} baseline)))))

(rule
 (alias runtest)
 (action
  (setenv
   SAREK_OPT_DISABLE
   "window"
   (setenv
    SAREK_EXPLAIN
    ""
    (run %{exe:test_policy_env.exe} window)))))

